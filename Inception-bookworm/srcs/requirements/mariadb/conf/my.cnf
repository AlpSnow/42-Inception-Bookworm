[mysqld]
bind-address = 0.0.0.0



# my.cnf est le fichier de configuration de MariaDB.
# Il contient différents blocs qui configurent les composants du serveur.


# [mysqld]
# Cela signifie :
# les paramètres suivants concernent le serveur MariaDB lui-même
# mysqld est le processus du serveur MariaDB.


# bind-address = 0.0.0.0
# Cette option définit :
# sur quelle adresse réseau MariaDB écoute
# 0.0.0.0 Cela signifie : MariaDB écoute sur toutes les interfaces réseau

# 127.0.0.1 MariaDB accepte seulement : les connexions locales
# dans le container mariadb -> OK
# depuis wordpress -> refusé d'ou le fait de mettre 0.0.0.0

